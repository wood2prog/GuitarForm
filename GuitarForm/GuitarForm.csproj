<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <Title>GuitarForm</Title>
    <Description>Guitar designer components for Grasshopper</Description>
    <TargetExt>.gha</TargetExt>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <NoWarn>NU1701;NETSDK1086;NETSDK1138</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- 24x24 component icons, loaded by file name through Icons.Load. Resources/Source holds the original artwork. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="GuitarForm.Icons.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuitarForm.Model\GuitarForm.Model.csproj" />
  </ItemGroup>

</Project>
