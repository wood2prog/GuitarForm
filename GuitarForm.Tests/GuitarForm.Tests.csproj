<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <NoWarn>NU1701;NETSDK1138</NoWarn>
  </PropertyGroup>

  <!-- Rhino.Testing loads the installed Rhino 8 into the test process, so RhinoCommon works as it does in Grasshopper.
       Test classes that use RhinoCommon types need the [RhinoTestFixture] attribute. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Rhino.Testing" Version="8.0.28-beta" />
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Rhino.Testing.Configs.xml" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <!-- The plug-in is referenced rather than compiling the geometry in, because NUnit loads every type in the test
       assembly before Rhino is set up, and the geometry classes need RhinoCommon to load. The .NET host only loads
       .dll files, so the .gha is copied next to the tests as GuitarForm.dll instead of through the reference. -->
  <ItemGroup>
    <ProjectReference Include="..\GuitarForm\GuitarForm.csproj" Private="false" />
  </ItemGroup>

  <Target Name="CopyPluginAsDll" AfterTargets="Build">
    <Copy SourceFiles="..\GuitarForm\bin\$(Configuration)\net7.0-windows\GuitarForm.gha"
          DestinationFiles="$(OutDir)GuitarForm.dll" SkipUnchangedFiles="true" />
  </Target>

</Project>
